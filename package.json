{
  "name": "dashsidian",
  "version": "2.2.0",
  "description": "Describe a dashboard, and your AI agent builds it in your note. Charts, habit streaks, heatmaps and goals from note properties, in YAML you can edit. No JavaScript, no Dataview, works on your phone.",
  "main": "main.js",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2"
  },
  "author": "Dmitriy Yurkin (Dimagious)",
  "scripts": {
    "build": "opdk build",
    "build:css": "opdk build-css",
    "build:skill": "node scripts/build-skill.cjs",
    "build:reference": "node scripts/build-reference.cjs",
    "build:vault": "opdk build --vault",
    "dev:vault": "opdk build --vault --watch",
    "preview": "node scripts/preview.cjs",
    "preview:watch": "node scripts/preview.cjs --watch",
    "test": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scorecard:check": "opdk scan",
    "site:check": "node scripts/site-check.cjs",
    "site:assemble": "node scripts/assemble-site.cjs",
    "readme:check": "node scripts/readme-check.cjs",
    "release:check": "node scripts/version-sync.cjs && npm run scorecard:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "release:zip": "node scripts/make-zip.cjs",
    "release": "npm run release:check && npm run release:zip",
    "release:audit": "node scripts/release-audit.cjs",
    "e2e:setup": "./scripts/e2e-setup.sh",
    "e2e": "./scripts/e2e-setup.sh && env -u ELECTRON_RUN_AS_NODE playwright test",
    "e2e:headed": "./scripts/e2e-setup.sh && env -u ELECTRON_RUN_AS_NODE playwright test --headed",
    "capture": "node scripts/capture.cjs",
    "social-card": "node scripts/social-card.cjs",
    "firstrun": "npm run build && node scripts/newcomer-vault.cjs && env -u ELECTRON_RUN_AS_NODE FIRSTRUN=1 DASHY_VAULT=.capture/newcomer playwright test e2e/firstrun.spec.ts --reporter=list"
  },
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "electron": "^44.9.1",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "obsidian": "latest",
    "obsidian-plugin-dev-kit": "github:Dimagious/obsidian-plugin-dev-kit#v0.1.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "eslint": "$eslint",
    "moment": "2.31.0"
  }
}
